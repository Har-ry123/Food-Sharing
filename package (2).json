{
  "name": "shareplate-fullstack",
  "version": "1.0.0",
  "description": "Community Food Sharing Platform - A social beneficial full-stack project",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "cd vite-project && npm run dev",
    "build": "cd vite-project && npm run build",
    "install-all": "npm install && cd vite-project && npm install"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
